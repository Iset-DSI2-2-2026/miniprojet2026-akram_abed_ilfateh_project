{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_label(form.isbn, 'ISBN', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.isbn, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    
    <div class="mb-3">
        {{ form_label(form.resume, 'Résumé', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.resume, {'attr': {'class': 'form-control', 'rows': 5}}) }}
    </div>
    
    <div class="row">
        <div class="col-md-4 mb-3">
            {{ form_label(form.nbPages, 'Nombre de pages', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nbPages, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-4 mb-3">
            {{ form_label(form.datePublication, 'Date de publication', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.datePublication, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-4 mb-3">
            {{ form_label(form.disponible, 'Disponible', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.disponible, {'attr': {'class': 'form-check-input'}}) }}
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.auteur, 'Auteur', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.auteur, {'attr': {'class': 'form-select'}}) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_label(form.genre, 'Genre', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.genre, {'attr': {'class': 'form-select'}}) }}
        </div>
    </div>
    
    <div class="mb-3">
        {{ form_label(form.tags, 'Tags', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.tags, {'attr': {'class': 'form-select'}}) }}
    </div>
    
    <div class="mb-3">
        {{ form_label(form.imageFile, 'Image de couverture', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
        {% if form.vars.data.imageName is defined and form.vars.data.imageName %}
            <div class="mt-2">
                <img src="{{ asset('uploads/livres/' ~ form.vars.data.imageName) }}" alt="Image actuelle" style="max-height: 100px;">
                <p class="text-muted small">Image actuelle</p>
            </div>
        {% endif %}
        <small class="text-muted">Formats acceptés: JPEG, PNG, WEBP. Max 2Mo</small>
    </div>
    
    <div style="display: flex; gap: 10px; margin-top: 20px;">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('app_livre_index') }}" class="btn btn-secondary">Annuler</a>
    </div>
{{ form_end(form) }}
