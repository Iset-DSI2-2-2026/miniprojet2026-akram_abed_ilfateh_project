{% extends 'base.html.twig' %}

{% block title %}Nouveau livre - BookShelf{% endblock %}

{% block body %}
{% if form.vars.errors|length > 0 %}
    <div class="alert alert-danger">
        {{ form_errors(form) }}
    </div>
{% endif %}
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">➕ Nouveau livre</h3>
        </div>
        <div class="card-body">
            {{ include('livre/_form.html.twig') }}
        </div>
    </div>
{% endblock %}