{% extends 'base.html.twig' %}

{% block title %}Auteurs - BookShelf{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style="margin: 0;">👤 Liste des auteurs</h2>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_auteur_new') }}" class="btn btn-primary">+ Ajouter</a>
            {% endif %}
        </div>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Nationalité</th>
                    <th>Livres</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for auteur in auteurs %}
                <tr>
                    <td>{{ auteur.nom }}</td>
                    <td>{{ auteur.prenom }}</td>
                    <td>{{ auteur.nationalite }}</td>
                    <td>{{ auteur.livres|length }}</td>
                    <td>
                        <a href="{{ path('app_auteur_show', {'id': auteur.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_auteur_edit', {'id': auteur.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucun auteur trouvé</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
