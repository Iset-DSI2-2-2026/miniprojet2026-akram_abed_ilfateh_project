{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_label(form.prenom) }}
            {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
        </div>
    </div>
    <div class="mb-3">
        {{ form_label(form.nationalite) }}
        {{ form_widget(form.nationalite, {'attr': {'class': 'form-control', 'placeholder': 'Française'}}) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.biographie) }}
        {{ form_widget(form.biographie, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Biographie...'}}) }}
    </div>
    <div class="action-buttons">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('app_auteur_index') }}" class="btn btn-secondary">Annuler</a>
    </div>
{{ form_end(form) }}