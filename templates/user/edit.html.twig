{% extends 'base.html.twig' %}

{% block title %}Modifier utilisateur - BookShelf{% endblock %}

{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header">
        <h2 style="margin: 0;">✏️ Modifier utilisateur</h2>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.pseudo) }}
                {{ form_widget(form.pseudo) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.roles) }}
                {{ form_widget(form.roles) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.plainPassword.first) }}
                {{ form_widget(form.plainPassword.first) }}
                <small class="text-muted">Laissez vide pour conserver le mot de passe actuel</small>
            </div>
            <div class="mb-3">
                {{ form_label(form.plainPassword.second) }}
                {{ form_widget(form.plainPassword.second) }}
            </div>
            <div style="display: flex; gap: 10px;">
                <button class="btn btn-primary">Mettre à jour</button>
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
