{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - BookShelf{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style="margin: 0;">👥 Gestion des utilisateurs</h2>
            <a href="{{ path('app_user_new') }}" class="btn btn-primary">+ Nouvel utilisateur</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Pseudo</th>
                    <th>Rôles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.pseudo }}</td>
                    <td>
                        {% for role in user.roles %}
                            <span class="badge badge-primary">
                                {% if role == 'ROLE_ADMIN' %}Admin
                                {% elseif role == 'ROLE_BIBLIOTHECAIRE' %}Bibliothécaire
                                {% else %}Utilisateur
                                {% endif %}
                            </span>
                        {% endfor %}
                    </td>
                    <td>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                        {% if app.user.id != user.id %}
                            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Supprimer cet utilisateur ?');" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucun utilisateur trouvé</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
