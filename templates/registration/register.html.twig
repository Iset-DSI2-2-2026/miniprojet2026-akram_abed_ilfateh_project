{% extends 'base.html.twig' %}

{% block title %}Inscription - BookShelf{% endblock %}

{% block body %}
<div class="container">
    <div class="card" style="max-width: 500px; margin: 50px auto;">
        <div class="card-header">
            <h2 style="margin: 0; text-align: center;">📝 Inscription</h2>
        </div>
        <div class="card-body">
            {{ form_start(registrationForm) }}
                
                <div class="form-group">
                    {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="form-group">
                    {{ form_label(registrationForm.pseudo, 'Pseudo', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.pseudo, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.pseudo) }}
                    <small class="text-muted">Lettres, chiffres et underscores uniquement</small>
                </div>

                <div class="form-group">
                    {{ form_label(registrationForm.plainPassword.first, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                <div class="form-group">
                    {{ form_label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.plainPassword.second) }}
                </div>

                <div class="form-group" style="margin: 20px 0;">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(registrationForm.agreeTerms) }}
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>

                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button type="submit" class="btn btn-primary">S'inscrire</button>
                    <a href="{{ path('app_login') }}" class="btn btn-secondary">Déjà inscrit ? Se connecter</a>
                </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}