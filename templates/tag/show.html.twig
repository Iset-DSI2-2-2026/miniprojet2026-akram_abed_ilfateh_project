{% extends 'base.html.twig' %}

{% block title %}{{ tag.nom }} - BookShelf{% endblock %}

{% block body %}
<div class="container">
    <div style="background: white; border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
        <h1 style="color: #007bff; margin-top: 0;">{{ tag.nom }}</h1>
        
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <th style="width: 30%; padding: 10px; text-align: left; border-bottom: 1px solid #ddd; background: #f8f9fa;">Nom</th>
                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                    <span style="display: inline-block; padding: 5px 15px; border-radius: 20px; background-color: {{ tag.couleur }}; color: white;">
                        {{ tag.nom }}
                    </span>
                </td>
            </tr>
            <tr>
                <th style="padding: 10px; text-align: left; border-bottom: 1px solid #ddd; background: #f8f9fa;">Couleur</th>
                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 50px; height: 30px; background-color: {{ tag.couleur }}; border: 1px solid #ddd;"></div>
                        <code>{{ tag.couleur }}</code>
                    </div>
                </td>
            </tr>
            <tr>
                <th style="padding: 10px; text-align: left; border-bottom: 1px solid #ddd; background: #f8f9fa;">Livres associés</th>
                <td style="padding: 10px; border-bottom: 1px solid #ddd;">{{ tag.livres|length }} livre(s)</td>
            </tr>
        </table>

        {% if tag.livres|length > 0 %}
            <h3 style="margin-top: 30px;">📚 Livres avec ce tag</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin-top: 20px;">
                {% for livre in tag.livres %}
                    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px;">
                        <h4 style="margin: 0 0 10px 0;">{{ livre.titre }}</h4>
                        <p style="margin: 5px 0; color: #666;">Auteur: {{ livre.auteur.prenom }} {{ livre.auteur.nom }}</p>
                        <p style="margin: 5px 0 15px 0;">Genre: {{ livre.genre.nom }}</p>
                        <a href="{{ path('app_livre_show', {'id': livre.id}) }}" style="background: #007bff; color: white; padding: 5px 12px; text-decoration: none; border-radius: 4px;">Voir le livre</a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        
        <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; display: flex; gap: 10px;">
            <a href="{{ path('app_tag_index') }}" style="background: #6c757d; color: white; padding: 8px 20px; text-decoration: none; border-radius: 4px;">← Retour</a>
            <a href="{{ path('app_tag_edit', {'id': tag.id}) }}" style="background: #ffc107; color: black; padding: 8px 20px; text-decoration: none; border-radius: 4px;">✏️ Modifier</a>
            {{ include('tag/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}